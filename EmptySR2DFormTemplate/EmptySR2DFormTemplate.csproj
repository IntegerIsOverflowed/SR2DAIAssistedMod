<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EmptySR2DFormTemplate - an EMPTY WinForms desktop project (.NET 10, x64) wired to SR2D:
    Program.cs + one blank form, exactly the file set Visual Studio generates for the
    "Windows Forms App" template, with nothing on the form.

    The only difference from the stock template: Form1 derives from SpriteForm (cs\SpriteForm.cs),
    the SR2D window whose title bar / border the engine draws itself, so the empty form already
    has the SR2D chrome. Everything else is what a new VS project gives you - delete nothing,
    start adding controls in Form1.Designer.cs or in code.

    Everything from ..\cs is compiled INTO this assembly (the SR2D classes are internal, and one
    assembly keeps them visible and lets the JIT inline across them), so nothing is referenced.
    SR2D64.dll is a normal None/Content project asset (including a linked file), a file beside
    this .csproj, or the copy already in the build output. Native repo folders are optional.
    cs/SR2D.Native.targets records source/output paths so the out-of-process designer finds it.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>   <!-- the default of a new project; ..\cs compiles either way -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Sr2d64CSport</RootNamespace>  <!-- the SR2D sources and their embedded icons live in it -->
    <AssemblyName>EmptySR2DFormTemplate</AssemblyName>
    <!-- DPI policy (same as the SR2DApp template): SR2D is a pixel engine - everything renders and
         hit-tests in DEVICE pixels, so the app declares SystemAware and the form uses
         AutoScaleMode.None (see Form1.Designer.cs). -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- where the SR2D sources and the DLL live, relative to this file -->
    <Sr2dCs Condition="'$(Sr2dCs)' == '' and Exists('$(MSBuildProjectDirectory)/cs/SR2D.cs')">$(MSBuildProjectDirectory)/cs</Sr2dCs>
    <Sr2dCs Condition="'$(Sr2dCs)' == ''">$(MSBuildProjectDirectory)/../cs</Sr2dCs>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevent duplicate default Compile items when cs/ is copied INSIDE this project. -->
    <Compile Remove="$(Sr2dCs)\**\*.cs" />
    <Compile Include="$(Sr2dCs)\*.cs" Link="cs\%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(Sr2dCs)\icons\*.bmp" LogicalName="Sr2d64CSport.%(Filename).bmp" Visible="false" />
  </ItemGroup>

  <!-- Keep this import when copying the project and cs/: no native/ repository layout is required. -->
  <Import Project="$(Sr2dCs)/SR2D.Native.targets" />
</Project>
