<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EmptySR2DFormTemplate - an EMPTY WinForms desktop project (.NET 10, x64) wired to SR2D:
    Program.cs + one blank form, exactly the file set Visual Studio generates for the
    "Windows Forms App" template, with nothing on the form.

    The only difference from the stock template: Form1 derives from SpriteForm (cs\SpriteForm.cs),
    the SR2D window whose title bar / border the engine draws itself, so the empty form already
    has the SR2D chrome. Everything else is what a new VS project gives you - delete nothing,
    start adding controls in Form1.Designer.cs or in code.

    Everything from ..\cs is compiled INTO this assembly (the SR2D classes are internal, and one
    assembly keeps them visible and lets the JIT inline across them), so nothing is referenced.
    SR2D64.dll is picked up from (first that exists) this folder, then ..\native\bin\x64\, and
    copied next to the exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>   <!-- the default of a new project; ..\cs compiles either way -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Sr2d64CSport</RootNamespace>  <!-- the SR2D sources and their embedded icons live in it -->
    <AssemblyName>EmptySR2DFormTemplate</AssemblyName>
    <!-- DPI policy (same as the SR2DApp template): SR2D is a pixel engine - everything renders and
         hit-tests in DEVICE pixels, so the app declares SystemAware and the form uses
         AutoScaleMode.None (see Form1.Designer.cs). -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- where the SR2D sources and the DLL live, relative to this file -->
    <Sr2dCs>..\cs</Sr2dCs>
    <Sr2dDll Condition="Exists('$(MSBuildProjectDirectory)\SR2D64.dll')">$(MSBuildProjectDirectory)\SR2D64.dll</Sr2dDll>
    <Sr2dDll Condition="'$(Sr2dDll)' == ''">..\native\bin\x64\SR2D64.dll</Sr2dDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(Sr2dCs)\*.cs" Link="cs\%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(Sr2dCs)\icons\*.bmp" LogicalName="Sr2d64CSport.%(Filename).bmp" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time hint: the absolute path of the DLL this build used, so the Visual Studio form
         designer (which does not run from bin\...) can load SR2D64.dll. -->
    <AssemblyMetadata Include="SR2D.DllPath" Value="$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(Sr2dDll)'))))" Condition="Exists('$(Sr2dDll)')" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="SR2D64.dll" />
    <None Include="$(Sr2dDll)" Link="SR2D64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('$(Sr2dDll)')" />
  </ItemGroup>

  <Target Name="Sr2dDllWarning" BeforeTargets="Build" Condition="!Exists('$(Sr2dDll)')">
    <Warning Text="SR2D64.dll not found ($(Sr2dDll)). Build it with build_release.bat (or native\SR2D.vcxproj, Release x64) or drop a copy next to this .csproj - the app will not start without it." />
  </Target>
</Project>
