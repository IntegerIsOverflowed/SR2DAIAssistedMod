<!-- headless vector import check: loads SVG / EPS / PDF files, rasterizes them, dumps raw RGBA (convert with tests/cs/topng.py) -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>/home/user/.cache/vecrun/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>/home/user/.cache/vecrun/obj/</BaseIntermediateOutputPath>
    <NoWarn>CA1416;WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../cs/*.cs" Exclude="../../../cs/SpriteBox*.cs;../../../cs/SpriteControls*.cs;../../../cs/SpriteCursors.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>
