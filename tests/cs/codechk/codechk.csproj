<!-- headless check of demo/CodeView.cs: every registered test's lambda must be extractable from Tests.cs -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>/home/user/.cache/codechk/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>/home/user/.cache/codechk/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../demo/CodeView.cs;Stubs.cs;Program.cs" />
    <EmbeddedResource Include="../../../demo/Tests.cs" LogicalName="src/Tests.cs" />
    <EmbeddedResource Include="../../../demo/ControlsDemo.cs" LogicalName="src/ControlsDemo.cs" />
  </ItemGroup>
</Project>
