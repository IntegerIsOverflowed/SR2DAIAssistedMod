<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B8BC965C-E33F-4AD9-BDC9-97CD32A109F6}</ProjectGuid>
    <RootNamespace>SR2D</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- default platform when none is given (msbuild SR2D.vcxproj from a shell): x64 -->
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <!-- ClangCL = LLVM clang-cl (Visual Studio component "C++ Clang tools for Windows"); it schedules the
         intrinsics a bit better than MSVC. To build with MSVC instead pass /p:PlatformToolset=v145 (or v143)
         - both toolsets pass the same bit-exact test-suite (tests/, GCC + clang). -->
    <PlatformToolset>ClangCL</PlatformToolset>
    <UseOfMfc>false</UseOfMfc>
    <CharacterSet>MultiByte</CharacterSet>
    <!-- /GL + /LTCG are MSVC-only (clang-cl ignores /GL and link then has nothing to LTCG) -->
    <WholeProgramOptimization Condition="'$(PlatformToolset)'!='ClangCL'">true</WholeProgramOptimization>
    <WholeProgramOptimization Condition="'$(PlatformToolset)'=='ClangCL'">false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(SolutionDir)bin\$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\</IntDir>
    <!-- x64 build is what the C# side loads (SR2D64.dll); x86 keeps the old name -->
    <TargetName Condition="'$(Platform)'=='x64'">SR2D64</TargetName>
    <TargetName Condition="'$(Platform)'=='Win32'">SR2D</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <OmitFramePointers>true</OmitFramePointers>
      <WholeProgramOptimization Condition="'$(PlatformToolset)'!='ClangCL'">true</WholeProgramOptimization>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <StringPooling>true</StringPooling>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <!-- /GS stack canaries are back ON (the default): the kernels draw caller- and file-shaped
           geometry, and a review found a heap OOB write class (DRAW_LINE2 degenerate segments) where a
           canary turns silent corruption into a loud crash. Measured cost is noise (tests/opbench A/B on
           the blit-heavy demo frame shape: within run-to-run noise; a user-side fps A/B found no
           difference either) - keep it on. -->
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <!-- No C++ exceptions / RTTI is DELIBERATE (no CRT startup, /ENTRY:DllMain) - do not "fix" this. -->
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <!-- /guard:cf indirect-call checks: compatible with the custom entry point and the static CRT
           (the dispatch tables are internal, nothing calls out through host function pointers). -->
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <!-- /sdl: ON since 2026-09-30 (B-01 follow-up). It promotes a specific set of dangerous-code
           warnings to ERRORS (uninitialized locals, unary minus on unsigned, buffer-overrun patterns,
           deprecated CRT calls) and pre-initializes some stack pointers so misuse crashes loudly instead of
           corrupting silently. It cannot change the pixel arithmetic - only what the compiler refuses to
           accept - so the differential tests stay valid. Flip back to false if it ever blocks a hotfix. -->
      <SDLCheck>true</SDLCheck>
      <FloatingPointModel>Precise</FloatingPointModel>
      <!-- SSE2 baseline for every TU (x64 default; explicit for Win32) -->
      <EnableEnhancedInstructionSet Condition="'$(Platform)'=='Win32'">StreamingSIMDExtensions2</EnableEnhancedInstructionSet>
      <!-- clang-cl: /arch:AVX2 also turns on FMA and contracts a*b+c by default; the AVX2 TU
           disables contraction with '#pragma clang fp contract(off)' so SSE2 and AVX2 kernels
           stay bit-identical. -fno-builtin is NOT needed for the DLL (only the test build of the
           original sources needs it, see tests/Makefile). -->
      <AdditionalOptions Condition="'$(PlatformToolset)'=='ClangCL'">-Wno-unused-command-line-argument %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- Restored 2026-09-30: the false-alarm fps rollback earlier this day spliced this file and
         dropped the whole Link block - the first native build after that failed with undefined
         memcpy / memset (nothing told the linker to pull the static CRT members that define them)
         and would have shipped a DLL without the SR2D.def export table. The explicit static CRT
         inputs also make the link independent of whether the toolset emits /defaultlib directives
         (the VS 18 clang-cl + /sdl combination was in the same build and remains suspected).
         Startup stays out: the entry point is DllMain, no CRT init runs. -->
    <Link>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <ModuleDefinitionFile>SR2D.def</ModuleDefinitionFile>
      <AdditionalDependencies>vcruntime.lib;libcmt.lib;libucrt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="sr2d.cpp" />
    <ClCompile Include="sr2d_kernels_sse2.cpp" />
    <ClCompile Include="sr2d_kernels_avx2.cpp">
      <!-- only this TU may contain VEX/AVX2 instructions; it is reached solely through the dispatch table -->
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="sr2d_api.h" />
    <ClInclude Include="sr2d_ops.h" />
    <ClInclude Include="sr2d_simd.h" />
    <None Include="sr2d_kernels.inl" />
    <None Include="sr2d_fx.inl" />
    <None Include="sr2d_select.inl" />
    <None Include="sr2d_voxel.inl" />
    <None Include="SR2D.def" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
