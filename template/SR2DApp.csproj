<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SR2D application template (WinForms, .NET 10, x64).

    Copy the whole "template" folder anywhere (or rename it in place), open the .csproj in Visual Studio /
    Rider / `dotnet build`, and start in MainForm.cs. Everything from ..\cs is compiled INTO this assembly
    (the SR2D classes are internal, and one assembly keeps them visible and lets the JIT inline across them),
    so nothing needs to be referenced: Sprite, SpriteBox, the Sprite* controls, VectorImage, VoxelGrid, ...

    The native DLL: SR2D64.dll is picked up from (first that exists)
       1. this folder                        (drop a copy here to pin a build)
       2. ..\native\bin\x64\SR2D64.dll       (what build_release.bat / the vcxproj produce)
    and copied next to the exe. If you move the project away from the repo, set <Sr2dCs> and <Sr2dDll> below.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>   <!-- the default of a new project; ..\cs compiles either way -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>         <!-- rules tuned in ..\.editorconfig (audit of 2026-09-23) -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Sr2d64CSport</RootNamespace>
    <AssemblyName>SR2DApp</AssemblyName>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- where the SR2D sources and the DLL live, relative to this file -->
    <Sr2dCs>..\cs</Sr2dCs>
    <Sr2dDll Condition="Exists('$(MSBuildProjectDirectory)\SR2D64.dll')">$(MSBuildProjectDirectory)\SR2D64.dll</Sr2dDll>
    <Sr2dDll Condition="'$(Sr2dDll)' == ''">..\native\bin\x64\SR2D64.dll</Sr2dDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- the whole SR2D C# side, linked in (shown under "cs" in the solution explorer) -->
    <Compile Include="$(Sr2dCs)\*.cs" Link="cs\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Design-time hint: the absolute path of the DLL this build used. The Visual Studio form designer runs the
      controls in its own process (DesignToolsServer.exe), which does not run from bin\... - without the hint
      the P/Invoke cannot find SR2D64.dll and the designer disables every SR2D control. SR2D.cs reads the hint
      as a fallback (see SR2D.DllPath / SR2D.IsAvailable); a shipped exe finds the copy next to itself first.
    -->
    <AssemblyMetadata Include="SR2D.DllPath" Value="$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(Sr2dDll)'))))" Condition="Exists('$(Sr2dDll)')" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="SR2D64.dll" />
    <None Include="$(Sr2dDll)" Link="SR2D64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('$(Sr2dDll)')" />
  </ItemGroup>

  <Target Name="Sr2dDllWarning" BeforeTargets="Build" Condition="!Exists('$(Sr2dDll)')">
    <Warning Text="SR2D64.dll not found ($(Sr2dDll)). Build it with build_release.bat (or native\SR2D.vcxproj, Release x64) or drop a copy next to this .csproj - the app will not start without it." />
  </Target>
</Project>
