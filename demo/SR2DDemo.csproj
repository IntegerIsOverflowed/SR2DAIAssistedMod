<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>   <!-- .NET 10 like the template -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>         <!-- rules tuned in ..\.editorconfig (audit of 2026-09-23) -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Sr2d64CSport</RootNamespace>
    <AssemblyName>SR2DDemo</AssemblyName>
    <TieredPGO>true</TieredPGO>
    <!-- false: with it on, WinForms' WM_INPUTLANGCHANGE handler (keyboard layout change, e.g. to Russian)
         throws CultureNotFoundException in InputLanguage.LanguageTag and killed the app while typing Cyrillic -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <!-- the refactored wrapper (same assembly, so the internal classes are visible) -->
    <Compile Include="..\cs\SR2D.cs" Link="cs\SR2D.cs" />
    <Compile Include="..\cs\Sprite.cs" Link="cs\Sprite.cs" />
