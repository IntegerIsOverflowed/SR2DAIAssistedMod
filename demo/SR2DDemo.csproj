  <ItemGroup>
    <!-- built-in pictures (Lenna + normal map); the procedural bricks need no files -->
    <EmbeddedResource Include="assets_builtin\*.webp" />
    <!-- designer toolbox icons (32-bit BMPs; LogicalName is namespace-qualified, which is where ToolboxBitmap looks first) -->
    <EmbeddedResource Include="..\cs\icons\*.bmp" LogicalName="Sr2d64CSport.%(Filename).bmp" />
    <!-- the demo shows its own source per test ("Code" button): Tests.cs / ControlsDemo.cs ride along inside the exe -->
    <EmbeddedResource Include="Tests.cs" LogicalName="src/Tests.cs" />
    <EmbeddedResource Include="ControlsDemo.cs" LogicalName="src/ControlsDemo.cs" />
    <EmbeddedResource Include="FractalLayout.cs" LogicalName="src/FractalLayout.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- drop SR2D64.dll next to the .csproj (or into bin\...) ; swap it freely to compare builds -->
    <None Include="SR2D64.dll" Condition="Exists('SR2D64.dll')" CopyToOutputDirectory="PreserveNewest" />
    <!-- design-time hint for the WinForms designer (its host process does not run from bin\...): where the DLL is -->
    <AssemblyMetadata Include="SR2D.DllPath" Value="$(MSBuildProjectDirectory)\SR2D64.dll" Condition="Exists('SR2D64.dll')" />
    <AssemblyMetadata Include="SR2D.DllPath" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\native\bin\x64\SR2D64.dll'))" Condition="!Exists('SR2D64.dll') and Exists('$(MSBuildProjectDirectory)\..\native\bin\x64\SR2D64.dll')" />
  </ItemGroup>
</Project>
